<Project Sdk="Transpose.Build.Target/26.7.2692">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SkipResourcesExtraction>true</SkipResourcesExtraction>
    <LangVersion>7.2</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="transpose-plotly-logo.png" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Transpose.BCL" Version="26.7.2882" />
    <PackageReference Include="Transpose.Core" Version="26.7.2884" />
  </ItemGroup>

  <PropertyGroup>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>(c) Copyright 2025 Curiosity GmbH - all right reserved</Copyright>
    <Company>Curiosity GmbH</Company>
    <Authors>Curiosity GmbH</Authors>
    <PackageProjectUrl>https://github.com/curiosity-ai/plotly-sharp</PackageProjectUrl>
    <AssemblyName>Transpose.Plotly</AssemblyName>
    <RootNamespace>Transpose.Plotly</RootNamespace>
    <PackageId>Transpose.Plotly</PackageId>
    <Description>Transpose.Plotly provides a strongly-typed binding to use Plotly on Transpose applications.</Description>
    <PackageTags>Plotly, Transpose, Graphs, Charts, HTML</PackageTags>
    <PackageIcon>transpose-plotly-logo.png</PackageIcon>
    <NoWarn>1701;1702;1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
